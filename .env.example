# Razorpay Payment Gateway Credentials (Live Mode)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Automated Order Email Dispatch & Receipt Notification (Optional / Highly Recommended)
# Configure in Vercel Project Settings -> Environment Variables to send live emails to info@eminsphere.com and customers
# Works with Gmail App Passwords, Hostinger, Zoho, Outlook, Amazon SES, Resend, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@eminsphere.com
SMTP_PASS=your_email_app_password
ORDER_NOTIFICATION_EMAIL=info@eminsphere.com
